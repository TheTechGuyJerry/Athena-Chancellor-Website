rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // CMS attachments directory: readable by all users, writable by authenticated users
    match /cms_attachments/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /cms/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
