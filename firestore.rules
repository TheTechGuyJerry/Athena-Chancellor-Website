rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null && (request.auth.token.email == 'jerryagbedun@gmail.com' || request.auth.token.admin == true);
    }

    match /essays/{document} {
      allow read: if true;
      allow write: if isSuperAdmin() || request.auth != null;
    }

    match /dispatches/{document} {
      allow read: if true;
      allow write: if isSuperAdmin() || request.auth != null;
    }

    match /inquiries/{document} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin() || request.auth != null;
    }

    match /subscribers/{document} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin() || request.auth != null;
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if isSuperAdmin() || request.auth != null;
    }
  }
}
