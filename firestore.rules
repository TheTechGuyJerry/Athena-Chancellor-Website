rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for authenticated users
    function isAuthenticated() {
      return request.auth != null;
    }

    // Content collections (Essays, Canon, Insights, Dispatches)
    match /essays/{document} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /osita_essays/{document} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /insights/{document} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /press_releases/{document} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /dispatches/{document} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /osita_dispatches/{document} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Site Settings & Newsletters
    match /settings/{document} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /osita_newsletters/{document} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Form Submissions (Inquiries, Subscribers)
    match /inquiries/{document} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /subscribers/{document} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // CMS Admin Users
    match /admin_users/{document} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }
  }
}

